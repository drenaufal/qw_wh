# ==============================================================================
# WAREHOUSE QUEUE & PICKUP SYSTEM (v4) - ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi .env.production atau .env.local di server Linux Anda:
#   cp .env.example .env.production
# ==============================================================================

# 1. DATABASE POSTGRESQL (Server Linux)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE_NAME>
DATABASE_URL=

# Variabel koneksi individual (opsional jika DATABASE_URL sudah diisi)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# 2. KEAMANAN & AUTENTIKASI (JWT Token)
# Ganti dengan string acak rahasia minimal 32 karakter:
JWT_SECRET=

# 3. KONFIGURASI APLIKASI WEB & JARINGAN WLAN
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production
NEXT_PUBLIC_APP_NAME=Warehouse Packing & Pickup Monitor
NEXT_PUBLIC_TIMEZONE=Asia/Jakarta

# 4. EXTERNAL ERP BUSINESS CENTRAL - PULL ORDERS (Posted Shipments)
EXTERNAL_ORDER_API_URL=
EXTERNAL_ORDER_API_AUTH_TYPE=
EXTERNAL_ORDER_API_USER=
EXTERNAL_ORDER_API_PASSWORD=

# 5. EXTERNAL ERP BUSINESS CENTRAL - PICKING API (Whse Shipment Pickings)
EXTERNAL_PICKING_API_URL=

# 6. EXTERNAL ERP BUSINESS CENTRAL - CREATE DISPATCH (Konfirmasi Serah Terima Selesai)
EXTERNAL_DISPATCH_API_URL=
