# ==============================================================================
# WAREHOUSE QUEUE & PICKUP SYSTEM (v4) - ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi .env.production atau .env.local di server Linux Anda:
#   cp .env.example .env.production
# ==============================================================================

# 1. DATABASE POSTGRESQL (Server Linux)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE_NAME>
DATABASE_URL=postgresql://wh_user:ganti_password_db_rahasia@localhost:5432/qw_whv4

# Variabel koneksi individual (opsional jika DATABASE_URL sudah diisi)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=qw_whv4
DATABASE_USER=wh_user
DATABASE_PASSWORD=ganti_password_db_rahasia

# 2. KEAMANAN & AUTENTIKASI (JWT Token)
# Ganti dengan string acak rahasia minimal 32 karakter:
JWT_SECRET=super-secret-jwt-key-warehouse-queue-2026-min-32-chars

# 3. KONFIGURASI APLIKASI WEB & JARINGAN WLAN
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production
NEXT_PUBLIC_APP_NAME=Warehouse Packing & Pickup Monitor
NEXT_PUBLIC_TIMEZONE=Asia/Jakarta

# 4. EXTERNAL ERP BUSINESS CENTRAL - PULL ORDERS (Posted Shipments)
EXTERNAL_ORDER_API_URL=https://bc.panatradeprestasi.com:7248/UAT/api/panatrade/warehouse/v1.0/companies(fdc329b5-9a4a-ed11-ac38-81e458651713)/postedWarehouseShipments?$expand=postedWarehouseShipmentLines&$filter=PostingDate ge 2026-01-01
EXTERNAL_ORDER_API_AUTH_TYPE=Basic
EXTERNAL_ORDER_API_USER=lsadmin
EXTERNAL_ORDER_API_PASSWORD=iFq49jRUGex7Qt/3KGGgfnUQL16Ppt6j0iLHsrFsV60=

# 5. EXTERNAL ERP BUSINESS CENTRAL - PICKING API (Whse Shipment Pickings)
EXTERNAL_PICKING_API_URL=https://bc.panatradeprestasi.com:7248/UAT/api/panatrade/warehouse/v1.0/companies(fdc329b5-9a4a-ed11-ac38-81e458651713)/whseShipmentPickings?$expand=whseShipmentPickingLines&$filter=postingDate ge 2026-01-01

# 6. EXTERNAL ERP BUSINESS CENTRAL - CREATE DISPATCH (Konfirmasi Serah Terima Selesai)
EXTERNAL_DISPATCH_API_URL=https://bc.panatradeprestasi.com:7248/UAT/api/panatrade/warehouse/v1.0/companies(fdc329b5-9a4a-ed11-ac38-81e458651713)/createDispatch
